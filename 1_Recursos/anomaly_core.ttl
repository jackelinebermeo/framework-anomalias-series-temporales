  rdfs:comment "Archivo asociado como evidencia (p.ej. PNG de comparación para embeddings visuales)."@es .

anom:computedAt
  rdf:type owl:DatatypeProperty ;
  rdfs:domain anom:Similarity ;
  rdfs:range xsd:dateTime ;
  rdfs:label "computed at"@en ;
  rdfs:label "calculado en"@es ;
  rdfs:comment "Fecha/hora del cálculo (opcional, para trazabilidad)."@es .


############################
# SimilarityRun
############################

anom:topK
  rdf:type owl:DatatypeProperty ;
  rdfs:domain anom:SimilarityRun ;
  rdfs:range xsd:integer ;
  rdfs:label "top K"@en ;
  rdfs:label "top K"@es ;
  rdfs:comment "K usado por la política TOP_K (por ejemplo, 2)."@es .

anom:sourceFile
  rdf:type owl:DatatypeProperty ;
  rdfs:domain anom:SimilarityRun ;
  rdfs:range xsd:string ;
  rdfs:label "source file"@en ;
  rdfs:label "archivo origen"@es ;
  rdfs:comment "Nombre/ruta del CSV desde el cual se cargaron los resultados."@es .

############################
# SelectionPolicy
############################

anom:policyId
  rdf:type owl:DatatypeProperty ;
  rdfs:domain anom:SelectionPolicy ;
  rdfs:range xsd:string ;
  rdfs:label "policy id"@en ;
  rdfs:label "id de política"@es ;
  rdfs:comment "Identificador de la política de selección (TOP_K, ALL_PAIRS)."@es .


#################################################################
# RESTRICCIONES OWL — Consistencia estructural
#################################################################

############################
# Point
############################
# Un Point debe pertenecer EXACTAMENTE a 1 Series
# y debe tener EXACTAMENTE una fecha y un valor

anom:Point
  rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty anom:isPointOf ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass anom:Series
    ] ,
    [ a owl:Restriction ;
      owl:onProperty anom:pointDate ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ,
    [ a owl:Restriction ;
      owl:onProperty anom:pointValue ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .


############################
# Series
############################
# Una Series debe tener EXACTAMENTE 1 Source
# y EXACTAMENTE 1 identificador de serie

anom:Series
  rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty anom:hasSource ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass anom:Source
    ] ,
    [ a owl:Restriction ;
      owl:onProperty anom:seriesId ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .


############################
# Anomaly
############################
# Una Anomaly:
# - pertenece EXACTAMENTE a 1 Series
# - tiene fechas de inicio y fin
# - es detectada por al menos 1 DetectionMethod
# - tiene al menos 1 Point (si aplica a tu definición)

anom:Anomaly
  rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty anom:locatedInSeries ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass anom:Series
    ] ,
    [ a owl:Restriction ;
      owl:onProperty anom:startDate ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ,
    [ a owl:Restriction ;
      owl:onProperty anom:endDate ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ] ,
    [ a owl:Restriction ;
      owl:onProperty anom:detectedBy ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass anom:DetectionMethod
    ] ,
    [ a owl:Restriction ;
      owl:onProperty anom:hasAnomalousPoint ;
      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass anom:Point
    ] .


############################
# Similarity
############################
# Un resultado de similitud:
# - compara EXACTAMENTE dos anomalías
# - proviene de EXACTAMENTE una ejecución
# - tiene EXACTAMENTE un valor de similitud

anom:Similarity
  rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty anom:betweenAnomalyA ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass anom:Anomaly
    ] ,
    [ a owl:Restriction ;
      owl:onProperty anom:betweenAnomalyB ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass anom:Anomaly
    ] ,
    [ a owl:Restriction ;
      owl:onProperty anom:fromRun ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass anom:SimilarityRun
    ] ,
    [ a owl:Restriction ;
      owl:onProperty anom:similarityValue ;
      owl:cardinality "1"^^xsd:nonNegativeInteger
    ] .


############################
# SimilarityRun
############################
# Una ejecución de similitud:
# - usa EXACTAMENTE un método
# - tiene EXACTAMENTE una política de selección

anom:SimilarityRun
  rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty anom:runMethod ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass anom:SimilarityMethod
    ] ,
    [ a owl:Restriction ;
      owl:onProperty anom:selectionPolicy ;
      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
      owl:onClass anom:SelectionPolicy
    ] .


############################
# Source (Datatype Properties)
############################

anom:sourceName
  rdf:type owl:DatatypeProperty ;
  rdfs:domain anom:Source ;
  rdfs:range xsd:string ;
  rdfs:label "source name"@en ;
  rdfs:label "nombre de la fuente"@es ;
  rdfs:comment "Nombre descriptivo del origen de la serie (observada, sintética, externa)."@es .

anom:sourceType
  rdf:type owl:DatatypeProperty ;
  rdfs:domain anom:Source ;
  rdfs:range xsd:string ;
  rdfs:label "source type"@en ;
  rdfs:label "tipo de fuente"@es ;
  rdfs:comment "Tipo controlado del origen de la serie. Valores esperados: observed, synthetic, external."@es .    






