# SimilarityRun -> SelectionPolicy
anom:selectionPolicy
  rdf:type owl:ObjectProperty ;
  rdfs:domain anom:SimilarityRun ;
  rdfs:range anom:SelectionPolicy ;
  rdfs:label "selection policy"@en ;
  rdfs:label "política de selección"@es ;
  rdfs:comment "Indica si se publican todas las parejas (ALL_PAIRS) o solo Top-K (TOP_K)."@es .



#################################################################
# DATATYPE PROPERTIES (IDs y atributos) — 
#################################################################

############################
# Anomaly
############################

# IDs útiles para enlazar desde CSV
anom:anomalyId
  rdf:type owl:DatatypeProperty ;
  rdfs:domain anom:Anomaly ;
  rdfs:range xsd:string ;
  rdfs:label "anomaly id"@en ;
  rdfs:label "id de anomalía"@es ;
  rdfs:comment "Identificador literal de la anomalía (si el CSV trae id)."@es .

# Ventana temporal y tamaño
anom:startDate
  rdf:type owl:DatatypeProperty ;
  rdfs:domain anom:Anomaly ;
  rdfs:range xsd:date ;
  rdfs:label "start date"@en ;
  rdfs:label "fecha de inicio"@es ;
  rdfs:comment "Fecha de inicio del evento/ventana anómala."@es .

anom:endDate
  rdf:type owl:DatatypeProperty ;
  rdfs:domain anom:Anomaly ;
  rdfs:range xsd:date ;
  rdfs:label "end date"@en ;
  rdfs:label "fecha de fin"@es ;
  rdfs:comment "Fecha de fin del evento/ventana anómala."@es .

anom:count
  rdf:type owl:DatatypeProperty ;
  rdfs:domain anom:Anomaly ;
  rdfs:range xsd:integer ;
  rdfs:label "count"@en ;
  rdfs:label "conteo"@es ;
  rdfs:comment "Número de puntos que componen la anomalía."@es .


############################
# NewsArticle
############################

