#################################################################
# Catálogo de métodos de similitud (Instancias)
#################################################################

anom:SM_DTW
  rdf:type anom:SimilarityMethod ;
  anom:similarityMethodId "SM_DTW" ;
  anom:similarityMethodName "Dynamic Time Warping" ;
  anom:similarityKind "numeric" ;
  rdfs:label "DTW"@es ;
  rdfs:label "DTW"@en ;
  rdfs:comment "Similitud numérica basada en Dynamic Time Warping entre ventanas/anomalías."@es .

anom:SM_EMB_VISUAL
  rdf:type anom:SimilarityMethod ;
  anom:similarityMethodId "SM_EMB_VISUAL" ;
  anom:similarityMethodName "Visual Embeddings" ;
  anom:similarityKind "visual" ;
  rdfs:label "Embeddings visuales"@es ;
  rdfs:label "Visual embeddings"@en ;
  rdfs:comment "Similitud visual entre anomalías basada en embeddings de imágenes (PNG) y ranking Top-K."@es .


#################################################################
# Catálogo de políticas de selección (SelectionPolicy)
#################################################################

anom:ALL_PAIRS
  rdf:type anom:SelectionPolicy ;
  anom:policyId "ALL_PAIRS" ;
  rdfs:label "Todas las parejas"@es ;
  rdfs:label "All pairs"@en ;
  rdfs:comment "Publica resultados de similitud para todas las combinaciones posibles de anomalías (comparación exhaustiva)."@es .

anom:TOP_K
  rdf:type anom:SelectionPolicy ;
  anom:policyId "TOP_K" ;
  rdfs:label "Top-K"@es ;
  rdfs:label "Top-K"@en ;
  rdfs:comment "Publica solo las K anomalías más similares por cada anomalía base, según el ranking calculado."@es .
