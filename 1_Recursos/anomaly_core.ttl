@prefix anom: <http://w3id.org/anomaly-core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontología (header)
#################################################################

<http://w3id.org/anomalycontext>
  rdf:type owl:Ontology ;
  rdfs:label "AnomalyContext Ontology"@en ;
  rdfs:comment "Ontology for modeling time series, observations (points), detected anomalies, prediction/detection methods, external temporal context from news, and anomaly similarity results."@en ;
  rdfs:comment "Ontología para modelar series temporales, observaciones (puntos), anomalías detectadas, métodos de predicción y detección, la comparación de anomalías de series originales frente a anomalías sintéticas generadas por distintos métodos, así como contexto temporal externo mediante noticias y categorías, y resultados de similitud entre anomalías."@es .

#################################################################
# CLASES
#################################################################

anom:Source
  rdf:type owl:Class ;
  rdfs:label "Source"@en ;
  rdfs:label "Origen"@es ;
  rdfs:comment "Entidad que representa el origen de una serie temporal (observada o sintética)."@es .

anom:Series
  rdf:type owl:Class ;
  rdfs:label "Series"@en ;
  rdfs:label "Serie"@es ;
  rdfs:comment "Serie temporal que agrupa observaciones ordenadas en el tiempo."@es .

anom:Point
  rdf:type owl:Class ;
  rdfs:label "Point"@en ;
  rdfs:label "Punto"@es ;
  rdfs:comment "Observación individual de una serie temporal, definida por una fecha y un valor."@es .

anom:Anomaly
  rdf:type owl:Class ;
  rdfs:label "Anomaly"@en ;
  rdfs:label "Anomalía"@es ;
  rdfs:comment "Ventana temporal anómala que agrupa uno o más puntos dentro de una serie temporal."@es .

anom:NewsArticle
  rdf:type owl:Class ;
  rdfs:label "News Article"@en ;
  rdfs:label "Noticia"@es ;
  rdfs:comment "Artículo periodístico que proporciona contexto explicativo sobre una o más anomalías."@es .

anom:Category
  rdf:type owl:Class ;
  rdfs:label "Category"@en ;
  rdfs:label "Categoría"@es ;
  rdfs:comment "Clasificación temática controlada para agrupar artículos de noticias."@es .

anom:PredictionMethod
  rdf:type owl:Class ;
  rdfs:label "Prediction Method"@en ;
  rdfs:label "Método de predicción"@es ;
  rdfs:comment "Algoritmo o enfoque utilizado para generar una serie temporal predicha."@es .

anom:DetectionMethod
  rdf:type owl:Class ;
  rdfs:label "Detection Method"@en ;
  rdfs:label "Método de detección"@es ;
  rdfs:comment "Algoritmo o enfoque utilizado para detectar anomalías en una serie temporal."@es .


anom:Similarity
  rdf:type owl:Class ;
  rdfs:label "Similarity"@en ;
  rdfs:label "Similitud"@es ;
  rdfs:comment "Resultado de comparación entre dos anomalías bajo un método específico (p.ej. DTW o embeddings visuales). Se modela como entidad intermedia para permitir múltiples métodos, ranking Top-K y trazabilidad."@es .

anom:SimilarityMethod
  rdf:type owl:Class ;
  rdfs:label "Similarity Method"@en ;
  rdfs:label "Método de similitud"@es ;
  rdfs:comment "Algoritmo/enfoque usado para calcular la similitud entre anomalías (DTW, embeddings visuales, etc.)."@es .

anom:SimilarityRun
  rdf:type owl:Class ;
  rdfs:label "Similarity Run"@en ;
  rdfs:label "Ejecución de similitud"@es ;
  rdfs:comment "Ejecución/experimento que produce uno o más resultados de similitud. Permite documentar política de selección (ALL_PAIRS vs TOP_K), topK y archivo fuente."@es .

anom:SelectionPolicy
  rdf:type owl:Class ;
  rdfs:label "Selection Policy"@en ;
  rdfs:label "Política de selección"@es ;
  rdfs:comment "Catálogo: ALL_PAIRS (todas las parejas) o TOP_K (solo K más similares por anomalía base)."@es .

##anom:SimilarityScale
#  rdf:type owl:Class ;
#  rdfs:label "Similarity Scale"@en ;
#  rdfs:label "Escala de similitud"@es ;
#  rdfs:comment "Catálogo de escalas/interpretación del valor: 0-1, 0-100, distancia (menor=mejor), etc."@es .


  
#################################################################
# OBJECT PROPERTIES (Relaciones)
#################################################################


# Similarity -> Anomaly (par comparado)
anom:betweenAnomalyA
  rdf:type owl:ObjectProperty ;
  rdfs:domain anom:Similarity ;
  rdfs:range anom:Anomaly ;
  rdfs:label "between anomaly A"@en ;
  rdfs:label "entre anomalía A"@es ;
  rdfs:comment "Anomalía base/origen de la comparación (útil para similitud dirigida Top-K)."@es .

anom:betweenAnomalyB
  rdf:type owl:ObjectProperty ;
  rdfs:domain anom:Similarity ;
  rdfs:range anom:Anomaly ;
  rdfs:label "between anomaly B"@en ;
  rdfs:label "entre anomalía B"@es ;
  rdfs:comment "Anomalía candidata/objetivo de la comparación."@es .


############################################################
# SimilarityRun ↔ SimilarityMethod
############################################################

anom:runMethod
  rdf:type owl:ObjectProperty ;
  rdfs:domain anom:SimilarityRun ;
  rdfs:range anom:SimilarityMethod ;
  rdfs:label "run method"@en ;
  rdfs:label "método de ejecución"@es ;
  rdfs:comment "Método aplicado en la ejecución (DTW o embeddings visuales)."@es ;
  owl:inverseOf anom:isRunMethodOf .

anom:isRunMethodOf
  rdf:type owl:ObjectProperty ;
  rdfs:domain anom:SimilarityMethod ;
  rdfs:range anom:SimilarityRun ;
  rdfs:label "is run method of"@en ;
  rdfs:label "es método de ejecución de"@es ;
  rdfs:comment "Ejecuciones de similitud en las que se utilizó este método."@es ;
  owl:inverseOf anom:runMethod .

############################################################
# Similarity ↔ SimilarityRun
############################################################

anom:fromRun
  rdf:type owl:ObjectProperty ;
  rdfs:domain anom:Similarity ;
  rdfs:range anom:SimilarityRun ;
  rdfs:label "from run"@en ;
  rdfs:label "proviene de ejecución"@es ;
  rdfs:comment "Ejecución de similitud que generó este resultado."@es ;
  owl:inverseOf anom:producesSimilarity .

anom:producesSimilarity
  rdf:type owl:ObjectProperty ;
  rdfs:domain anom:SimilarityRun ;
  rdfs:range anom:Similarity ;
  rdfs:label "produces similarity"@en ;
  rdfs:label "produce similitud"@es ;
  rdfs:comment "Resultados de similitud generados por una ejecución."@es ;
  owl:inverseOf anom:fromRun .




