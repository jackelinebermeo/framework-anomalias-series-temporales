anom:news_20070727_correa_shark_fins
  rdf:type anom:NewsArticle ;
  anom:newsTitle 'Correa defiende política sobre pesca de tiburones en Ecuador' ;
  anom:newsSource 'MyPlainview (AP)' ;
  anom:newsUrl <https://www.myplainview.com/news/article/Correa-defiende-pol-tica-sobre-pesca-de-8541331.php> ;
  anom:publishedAt '2007-07-27'^^xsd:date ;
  anom:hasCategory anom:cat_medio_ambiente ;
  anom:newsText """ El presidente Rafael Correa defendió un decreto relacionado con la pesca y comercialización de aletas de tiburón, indicando que su gobierno mantenía una agenda ambiental, mientras respondía a críticas de grupos conservacionistas y a la polémica por posibles incentivos al comercio de aletas. Se mencionan controles, pesca artesanal y el debate público sobre conservación marina.""" .

anom:news_20070816_correa_lifts_bank_secrecy
  rdf:type anom:NewsArticle ;
  anom:newsTitle 'Ecuador: Correa autoriza levantar secreto bancario' ;
  anom:newsSource 'MyPlainview (AP)' ;
  anom:newsUrl <https://www.myplainview.com/news/article/Ecuador-Correa-autoriza-levantar-secreto-bancario-8581913.php> ;
  anom:publishedAt '2007-08-16'^^xsd:date ;
  anom:hasCategory anom:cat_politica_gobierno ;
  anom:newsText """ Rafael Correa autorizó levantar el secreto bancario de sus cuentas dentro y fuera del país para facilitar una investigación solicitada por el Congreso. La nota describe el trasfondo político de la indagación y el objetivo de transparentar el manejo de fondos y el patrimonio de funcionarios.""" .

anom:news_20070816_galapagos_illegal_residents
  rdf:type anom:NewsArticle ;
